# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Ixtiyoriy: akkauntga admin paneldagi "Telegram akkaunt" sahifasidan kirish mumkin
TG_SESSION_STRING=
# @BotFather bergan token — adminga hisobot va tasdiq tugmalari uchun
TG_BOT_TOKEN=
# Admin(lar)ning Telegram ID raqami, vergul bilan (@userinfobot orqali bilish mumkin)
ADMIN_IDS=
# https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
POSTGRES_PASSWORD=

# Veb admin panel (ADMIN_PASSWORD bo'sh bo'lsa panel yoqilmaydi)
ADMIN_USER=admin
ADMIN_PASSWORD=
# Tasodifiy uzun satr: openssl rand -hex 32
SECRET_KEY=
